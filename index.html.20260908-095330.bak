<!-- 01 ────────────────────────────────────────── the horizon, first of three -->
<section id="s1" aria-label="Introduction">
  <canvas id="field" aria-hidden="true"></canvas>
  <!-- the hero object. all keyframe, so a scroll can land anywhere in it -->
  <div class="hero-film" aria-hidden="true">
    <video id="scrubfilm" muted playsinline preload="auto" disablepictureinpicture
           poster="/film/own_01_fall_poster.jpg">
      <!-- webm first: firefox scrubs mp4 choppily even at one keyframe per
           frame. ios safari refuses webm, so it falls through to the mp4. -->
      <source src="/film/hero_scrub.webm" type="video/webm">
      <source src="/film/hero_scrub.mp4" type="video/mp4">
    </video>
  </div>

  <div class="wrap">

<!-- 05 ────────────────────────────────────────── service -->
<section id="s5" aria-label="Service" data-overline="REPUBLIC OF KOREA MARINE CORPS" data-overline-dir="ltr" data-invert>
  <div class="wrap grid">
    <div class="sec-head rail-l">
      <span class="n">04</span>
      <span class="lb"><span data-en data-scramble>Service</span><span data-ko>복무</span></span>
    </div>
    <!-- The head's twin. Built from the same markup so its rule is the same
         length and its label sits on the same line: the period where the
         number is, the length of it where the label is. The two frame what
         stands between them. -->
    <div class="sec-head twin" aria-hidden="true">
      <span class="n">2021.06 → 2022.12</span>
      <span class="lb"><span data-en>Eighteen months</span><span data-ko>18개월</span></span>
    </div>

    <div class="build" data-reveal data-skew>
      <!-- the seal above its type: a lockup with no left and no right -->
      <div class="lockup">
        <img class="lockup-seal" data-proximity src="/marks/rokmc-ega.svg" alt="" width="220" height="227" loading="lazy" decoding="async">
        <span class="lockup-bar" aria-hidden="true"></span>
        <span class="lockup-type">
          <span class="lockup-1">REPUBLIC OF KOREA</span>
          <span class="lockup-2">MARINE CORPS</span>
          <span class="lockup-3">대한민국 해병대 &middot; 백령도</span>
        </span>
      </div>
      <!-- two tiers: the fact in the display grotesque, the qualifier under it
           in the serif italic. Korean reads place first, so its small line
           goes above and 18개월 is the big one. -->
      <h2 class="big-line">
        <span data-en><span class="t1">Eighteen months</span><span class="t2">on the northern line.</span></span>
        <span data-ko><span class="t2">북방한계선에서</span><span class="t1">18개월.</span></span>
      </h2>
      <!-- 兵 1271期 and the tag, worn together. The corps writes an enlisted
           class in hanja, 兵 for the intake, 期 for the class; 병 1271기 enlisted
           28 June 2021 and was discharged 27 December 2022. The class patch is
           cut open in gold because the crimson is a field in one place only. -->
      <p class="idline">
        <span class="klasstag" aria-label="병 1271기"><span class="h">兵</span><span class="n">1271</span><span class="h">期</span></span>
        <span class="nametag" aria-hidden="true">이규민</span>
      </p>
    </div>
  </div>

  <div class="wrap">
    <!-- Six cells of one size and one mount, three by two. The photographs
         take the corners, the map and the record take the centre column, so
         the axis the opener set runs down the middle and the balance is a
         property of the grid. Every cell carries the same caption bar. -->
    <div class="plate-row m6" data-reveal>
      <figure class="plate cell">
        <div class="win"><picture>
          <source type="image/avif" srcset="/plates/rokmc_squad_540.avif 540w, /plates/rokmc_squad_810.avif 810w, /plates/rokmc_squad_1080.avif 1080w" sizes="(max-width: 900px) 92vw, 46vw">
          <source type="image/webp" srcset="/plates/rokmc_squad_540.webp 540w, /plates/rokmc_squad_810.webp 810w, /plates/rokmc_squad_1080.webp 1080w" sizes="(max-width: 900px) 92vw, 46vw">
          <img class="pl" src="/plates/rokmc_squad_810.jpg" srcset="/plates/rokmc_squad_540.jpg 540w, /plates/rokmc_squad_810.jpg 810w, /plates/rokmc_squad_1080.jpg 1080w" sizes="(max-width: 900px) 92vw, 46vw"
               width="1080" height="720" loading="lazy" decoding="async"
               style="background-image:url('data:image/jpeg;base64,')"
               alt="A Marine Corps squad in red physical training uniform, seated outdoors on Baengnyeongdo under an open sky, August 2022.">
        </picture></div>
        <figcaption><span class="pl-n">01</span><span class="pl-t"><span data-en>Baengnyeongdo</span><span data-ko>백령도</span></span><span class="pl-d">2022.08</span></figcaption>
      </figure>
      <figure class="plate cell map">
        <div class="win">
      <div class="locator-frame">
            <img class="loc-wide" src="/marks/nw_border.svg" alt="" width="1000" height="634" loading="lazy" decoding="async">
            <span class="loc-n" aria-hidden="true">N</span>
            <span class="loc-lbl loc-lbl-kp" aria-hidden="true">DPRK</span>
            <span class="loc-lbl loc-lbl-kr" aria-hidden="true">ROK</span>
          </div>
        </div>
        <figcaption><span class="pl-n">NLL</span><span class="pl-t"><span data-en>Baengnyeongdo</span><span data-ko>백령도</span></span><span class="pl-d">37°58′N 124°41′E</span></figcaption>
      </figure>
      <figure class="plate cell">
        <div class="win"><picture>
          <source type="image/avif" srcset="/plates/rokmc_hq_540.avif 540w, /plates/rokmc_hq_810.avif 810w, /plates/rokmc_hq_1080.avif 1080w" sizes="(max-width: 900px) 92vw, 46vw">
          <source type="image/webp" srcset="/plates/rokmc_hq_540.webp 540w, /plates/rokmc_hq_810.webp 810w, /plates/rokmc_hq_1080.webp 1080w" sizes="(max-width: 900px) 92vw, 46vw">
          <img class="pl" src="/plates/rokmc_hq_810.jpg" srcset="/plates/rokmc_hq_540.jpg 540w, /plates/rokmc_hq_810.jpg 810w, /plates/rokmc_hq_1080.jpg 1080w" sizes="(max-width: 900px) 92vw, 46vw"
               width="1080" height="720" loading="lazy" decoding="async"
               style="background-image:url('data:image/jpeg;base64,')"
               alt="Six Marines outside the Education and Training Group headquarters, the corps insignia mounted on the facade above them, April 2022.">
        </picture></div>
        <figcaption><span class="pl-n">02</span><span class="pl-t"><span data-en>Education and Training Group</span><span data-ko>교육훈련단</span></span><span class="pl-d">2022.04</span></figcaption>
      </figure>
      <figure class="plate cell">
        <div class="win"><picture>
          <source type="image/avif" srcset="/plates/rokmc_barracks_540.avif 540w, /plates/rokmc_barracks_810.avif 810w, /plates/rokmc_barracks_1080.avif 1080w" sizes="(max-width: 900px) 92vw, 42vw">
          <source type="image/webp" srcset="/plates/rokmc_barracks_540.webp 540w, /plates/rokmc_barracks_810.webp 810w, /plates/rokmc_barracks_1080.webp 1080w" sizes="(max-width: 900px) 92vw, 42vw">
          <img class="pl" src="/plates/rokmc_barracks_810.jpg" srcset="/plates/rokmc_barracks_540.jpg 540w, /plates/rokmc_barracks_810.jpg 810w, /plates/rokmc_barracks_1080.jpg 1080w" sizes="(max-width: 900px) 92vw, 42vw"
               width="1496" height="1122" loading="lazy" decoding="async"
               style="background-image:url('data:image/jpeg;base64,')" alt="A barracks room full of Marines posing for a group photograph, September 2022.">
        </picture></div>
        <figcaption><span class="pl-n">03</span><span class="pl-t"><span data-en>Barracks</span><span data-ko>생활관</span></span><span class="pl-d">2022.09</span></figcaption>
      </figure>
      <!-- a cell, not a plate: the site hides any plate that has no photograph -->
      <div class="cell rec">
        <div class="win">
          <p class="cap">
            <span data-en>Infantry, Republic of Korea Marine Corps. Eighteen months on the northwest border area, on the closest inhabited island to the line.</span>
            <span data-ko>대한민국 해병대 보병. 서북도서에서 18개월. 경계선에 가장 가까운 유인도에서.</span>
          </p>
          <div class="lines">
            <p class="data">

<body>

<div id="intro" aria-hidden="true">
  <canvas id="introcv"></canvas>
  <!-- the cards set up the line the hero then says outright -->
  <!-- The frame's own instruments. Every value here is a property of the
       footage rather than a claim about the jump: the timecode and the
       frame count are true by construction, and the brackets are framing.
       Nothing asserts an altitude or a speed we cannot stand behind. -->
  <div class="film-type">
    <span class="ft-corner ft-tl" aria-hidden="true"></span>
    <span class="ft-corner ft-tr" aria-hidden="true"></span>
    <span class="ft-corner ft-bl" aria-hidden="true"></span>
    <span class="ft-corner ft-br" aria-hidden="true"></span>

    <span class="ft-slug" data-ft="0">KYUMIN LEE</span>
    <span class="ft-reel" data-ft="1">
      <b class="ft-tc">00:00:00:00</b>
      <em class="ft-lbl">TC</em>
    </span>
    <span class="ft-meta" data-ft="2">
      <b>MINNESOTA</b><em>LOC</em>
    </span>
    <span class="ft-gauge" data-ft="3" aria-hidden="true"><i></i></span>
    <span class="ft-cross" aria-hidden="true"></span>
  </div>
  <button id="skip"><span data-en>Skip</span><span data-ko>건너뛰기</span></button>
</div>

<a class="skip-link" href="#s1"><span data-en>Skip to content</span><span data-ko>본문으로 건너뛰기</span></a>


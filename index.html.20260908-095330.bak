<script>
/* ---- the record. 13 rows, then one line under the table ---- */
const EV=[
 ["2026.02-2026.06",
  "Two overseas entities. Incorporation, paid-in capital, bank accounts, local counsel run directly.",
  "해외 법인 두 곳. 설립, 자본금 납입, 은행 계좌, 현지 로펌 직접 상대.",
  "2 entities, 2 jurisdictions","법인 2, 관할 2","Operating","운영 중",1],
 ["2026.02-2026.06",
  "An international financial license application, contributed to. An in-flight filing taken over and closed out.",
  "국제 금융 라이선스 신청 기여. 진행 중이던 건 인수 후 종결.",
  "1 filing","신청 1건","Closed out","종결",0],
 ["2026.02-",
  "Statutes, licensing guidelines, regulator filing formats, and issuer attestation reports collected and read in the original.",
  "법령 원문, 라이선스 가이드라인, 감독당국 제출 양식, 발행사 준비금 증명 리포트를 원문으로 수집해 판독.",
  "8 ASEAN jurisdictions","ASEAN 관할 8","Ongoing","진행 중",1],
 ["2026.03-",
  "An account-based, multi-channel outbound program designed end to end. Decision-maker mapping, sequences, cadence, leave-behind material.",
  "계정 기반 멀티채널 아웃바운드 프로그램 전 구간 설계. 의사결정자 매핑, 시퀀스, 케이던스, 리브비하인드 자료.",
  "Generators, sheets, trackers, a web console","생성기, 시트, 트래커, 웹 콘솔","Running","가동 중",1],
 ["2026",
  "A five-year revenue model on four engines, built from unit assumptions with the source sheet attached.",
  "4엔진 5개년 매출 모델. 단위 가정에서 쌓고 근거 시트 첨부.",
  "4 engines, 5 years","4엔진 5개년","In use","사용 중",1],
 ["2026",
  "A mutual non-disclosure agreement drafted in English and Korean as mirrors.",
  "영문과 국문을 미러로 기안한 상호비밀유지계약.",
  "3 versions, 2 languages","3판, 2개 언어","In use","사용 중",1],
 ["2026.03-",
  "A layout audit walks every element on every slide and stops the build on four classes of overflow. The decks themselves are written in HTML and rendered through headless Chrome and vector PDF into Keynote. <span class='tail'>On request.</span>",
  "레이아웃 감사가 슬라이드마다 모든 요소를 훑어 넘침 4종에서 빌드를 중단. 덱 자체는 HTML로 쓰고 헤드리스 Chrome과 벡터 PDF를 거쳐 키노트로. <span class='tail'>요청 시 제시.</span>",
  "251 lines. 3 projects. Diff of 1 line","251줄. 프로젝트 3. 차이 1줄","In use","사용 중",1],
 ["2026.02-",
  "Decks, documents, and sheets generated from code rather than typed. <span class='tail'>On request.</span>",
  "덱과 문서, 시트를 손이 아니라 코드로 생성. <span class='tail'>요청 시 제시.</span>",
  "73 scripts, 23,683 lines","스크립트 73, 23,683줄","In use","사용 중",1],
 ["2026",
  "A review delivered as a graded defect list. Each finding quoted to its source with a recommended fix. Method cited to published literature.",
  "등급화된 결함 목록으로 낸 검토. 항목마다 원문 인용과 권고 수정안. 방법론은 공개 문헌 인용.",
  "25 defects, 11 documents","결함 25, 문서 11","Delivered","납품",0],
 ["2024.01-2025.11",
  "A digital wealthtech platform. Multi-asset portfolio dashboard, legal document system with automated generation and EVM anchoring for integrity verification, an AI legal assistant with chat and voice, brokerage API integration, CI/CD with monitoring. Co-founder and lead full-stack engineer.",
  "디지털 웰스테크 플랫폼. 멀티자산 포트폴리오 대시보드, 자동 생성과 EVM 앵커링 무결성 검증을 붙인 법률 문서 시스템, 챗과 음성을 갖춘 AI 법률 어시스턴트, 증권 API 연동, 모니터링을 붙인 CI/CD. 공동창업자 겸 리드 풀스택 엔지니어.",
  "23 months","23개월","Ended","종료",0],
 ["2020-2024.05",
  "Bachelor of Arts, Computer Science. University of Minnesota Twin Cities. <img class='mark-inline' src='/marks/umn.svg' alt='' loading='lazy' decoding='async' height='18'>",
  "컴퓨터공학 학사. University of Minnesota Twin Cities. <img class='mark-inline' src='/marks/umn.svg' alt='' loading='lazy' decoding='async' height='18'>",
  "GPA 3.68 / 4.00","GPA 3.68 / 4.00","Ended","종료",0],
 ["2021.06-2022.12",
  "Republic of Korea Marine Corps, sergeant. Baengnyeongdo, on the northern limit line.",
  "대한민국 해병대 병장. 백령도.",
  "18 months","18개월","Ended","종료",0],
 ["2022.04-2022.05",
  "Interpreter, ROK-US combined intelligence section. Real-time interpretation of intelligence briefings for senior officers during a theater-level exercise.",
  "한미연합 정보처 통역병. 연합지휘소훈련에서 고위 장교 정보 브리핑 실시간 통역.",
  "2 months","2개월","Ended","종료",0]
];

const HEAD={en:["Period","What","Scale","State"],ko:["기간","내용","규모","상태"]};
const LANDMARK={
  en:{s1:"Introduction",s3:"Current work",s4:"Capability",s5:"Record",s6:"06",s7:"Direction",s8:"Contact"},
  ko:{s1:"소개",s3:"하는 일",s4:"할 수 있는 것",s5:"기록",s6:"06",s7:"지향",s8:"연락"}
};
const META={
  en:{t:"Kyumin Lee",
      d:"Builder on one side. Dealmaker on the other. Cross-border settlement and stablecoin infrastructure across Southeast Asia, and the engineering behind it."},
  ko:{t:"이규민",
      d:"만드는 쪽에 앉는다. 파는 쪽에도 앉는다. 동남아 국경 간 정산과 스테이블코인 인프라, 그리고 그 밑의 엔지니어링."}
};

window.renderRows=function(){
  if(!document.getElementById('evbody')) return;   // the record table was removed
  const L=document.documentElement.getAttribute('data-lang')==='ko'?'ko':'en';
  const w=L==='en'?1:2, sc=L==='en'?3:4, st=L==='en'?5:6;

  document.getElementById('evhead').innerHTML=
    '<th scope="col">'+HEAD[L].join('</th><th scope="col">')+'</th>';

  document.getElementById('evbody').innerHTML=EV.map(r=>
    '<tr>'+
      '<td class="p">'+r[0]+'</td>'+
      '<td class="w">'+r[w]+'</td>'+
      '<td class="sc">'+r[sc]+'</td>'+
      '<td class="st'+(r[7]?'':' past')+'">'+r[st]+'</td>'+
    '</tr>').join('');

  for(const id in LANDMARK[L]){
    const el=document.getElementById(id);
    if(el) el.setAttribute('aria-label',LANDMARK[L][id]);
  }
  document.title=META[L].t;
  document.querySelector('meta[name="description"]')?.setAttribute('content',META[L].d);
  document.querySelector('meta[property="og:title"]')?.setAttribute('content',META[L].t);
  document.querySelector('meta[property="og:description"]')?.setAttribute('content',META[L].d);
  const play=document.querySelector('.play');
  if(play) play.setAttribute('aria-label',L==='en'?'Play':'재생');
};
window.renderRows();

/* ---- the top bar inverts while it sits over the stage ---- */
(function(){
  const stage=document.getElementById('s6'); if(!stage||!('IntersectionObserver' in window)) return;
  let io=null;
  const arm=()=>{
    io?.disconnect();
    const bar=parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--bar'))||56;
    io=new IntersectionObserver(([e])=>{
      document.documentElement.classList.toggle('stage-bar',e.isIntersecting);
    },{rootMargin:'0px 0px -'+Math.max(0,innerHeight-bar)+'px 0px'});
    io.observe(stage);
  };
  arm();
  let t; addEventListener('resize',()=>{ clearTimeout(t); t=setTimeout(arm,200) },{passive:true});
})();

/* ---- pa-01. arms itself only when a source is dropped in ---- */
(function(){
  const btn=document.querySelector('.play');
  if(!btn||!btn.dataset.src) return;
  const a=new Audio(btn.dataset.src);
  const bar=document.querySelector('.wave i');
  btn.setAttribute('aria-disabled','false');
  btn.addEventListener('click',()=>{ a.paused?a.play():a.pause() });
  a.addEventListener('timeupdate',()=>{ if(bar&&a.duration) bar.style.width=(a.currentTime/a.duration*100)+'%' });
})();
</script>
<script type="module" src="/src/main.js"></script>
</body>
</html>
